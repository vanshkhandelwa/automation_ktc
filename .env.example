PORT=3001
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Generate both values with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro-latest
AUTOMATION_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/your-automation-id
AUTOMATION_WEBHOOK_TOKEN=your-webhook-bearer-token

# Meta WhatsApp Business Cloud API (WBMCP) — do not commit real values
# Prefer: npx -y wbmcp@latest auth  (saves to ~/.config/wbmcp/config.json)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_APP_SECRET=
